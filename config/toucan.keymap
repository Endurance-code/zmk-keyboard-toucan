#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        AS: AS {
            compatible = "zmk,behavior-hold-tap";
            label = "AS";
            bindings = <&caps_word>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&trans  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &trans  &trans  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &trans  &trans  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &trans  &kp LEFT_CONTROL  &mo 2  &kp SPACE  &kp RET  &mo 1  &kp BACKSPACE
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR  &kp PERCENT  &bt BT_CLR  &trans  &kp UP  &trans  &bt BT_SEL 0  &trans  &trans  &kp LCTRL  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &bt BT_SEL 1  &trans  &trans  &kp TILDE  &trans  &trans  &kp SEMICOLON  &kp TAB  &trans  &trans  &trans  &trans  &bt BT_SEL 2  &trans  &kp LEFT_CONTROL  &kp ESC  &kp SPACE  &kp RET  &trans  &kp BACKSPACE
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp LEFT_ALT  &kp KP_MINUS  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL  &trans  &trans  &kp SLASH  &kp BACKSLASH  &kp LBKT  &kp RBKT  &kp MINUS  &kp PLUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp SLASH  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PERIOD  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp ASTERISK  &trans  &kp LGUI  &trans  &kp SPACE  &kp RET  &kp KP_NUMBER_0  &kp BACKSPACE
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&mo TAB  &trans  &kp F7  &kp F8  &kp F9  &kp F12  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans  &kp BSPC  &kp LCTRL  &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &bt LSHFT  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &mo NAV  &kp SPACE  &kp RET  &mo 2  &kp RALT
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
